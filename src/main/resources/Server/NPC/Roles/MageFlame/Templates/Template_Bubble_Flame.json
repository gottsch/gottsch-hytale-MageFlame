{
  "Type": "Abstract",
  "$Comment": "Waterproof: no InWater extinguish rule. Generated by make_flame_type.py from Template_Mage_Flame.json for the Bubble Flame flame; edit FLAME_TYPES or the base template, not this file. Base for the Mage Flame slot roles (Mage_Flame_Slot1..4). Structure copied from the vanilla Server/NPC/Roles/_Core/Tests/Test_Pet_Lantern.json: hovering walker that joins the nearest player's flock and seeks them, with a DespawnTimer lifespan and interact-to-dismiss. Each slot role only sets where this flame floats (distance + height), so several flames do not fight over one spot. ApplySeparation is false: the slots do the spacing, and separation made flames drift in front of the player's face.",
  "StartState": "Idle",
  "DefaultSubState": "Default",
  "Appearance": "Bubble_Flame",
  "Invulnerable": true,
  "FlockAllowedNPC": [
    "Bubble_Flame_Slot1",
    "Bubble_Flame_Slot2",
    "Bubble_Flame_Slot3",
    "Bubble_Flame_Slot4"
  ],
  "ApplySeparation": false,
  "MaxHealth": 50,
  "NameTranslationKey": "server.npcRoles.Bubble_Flame.name",
  "Parameters": {
    "DespawnTimer": {
      "Value": 86400,
      "Description": "Safety net only: the plugin removes flames after MageFlameLifespanSeconds (MageFlame.json). This role timer only matters if the plugin is not running, so it is set to a day."
    },
    "FollowStopDistance": {
      "Value": 3,
      "Description": "How far from the player this flame settles."
    },
    "FollowSlowDownDistance": {
      "Value": 5,
      "Description": "Distance from the player at which this flame starts to slow down."
    },
    "CatchUpTeleportDistance": {
      "Value": 8,
      "Description": "If no player is within this many blocks, the flame teleports next to its leader. Keep it short underground, where a flame left behind in a tunnel is no use."
    },
    "IndoorFollowOffset": {
      "Value": [
        0,
        1.4,
        0
      ],
      "Description": "Where the flame floats relative to its owner when sky light is low (underground, caves, indoors): [x, height above the owner's feet, z]. Keep the height low enough for a 2-block mining tunnel (flame top = height + 0.3)."
    },
    "OutdoorFollowOffset": {
      "Value": [
        0,
        2.6,
        0
      ],
      "Description": "Where the flame floats relative to its owner in the open: [x, height above the owner's feet, z]."
    },
    "IndoorTeleportDistance": {
      "Value": 10,
      "Description": "Underground (low sky light): a flame that cannot see its owner, or is farther than this many blocks away, teleports next to them. Walls and tunnel bends break line of sight at once, so a flame never stays behind a corner."
    }
  },
  "MotionControllerList": [
    {
      "$Comment": "Fly, not Walk: a flame has no legs. MinAirSpeed 0 lets it hover still. Height follows the OWNER (the follow instructions seek a point above them), not the ground, so DesiredAltitudeWeight is 0 and Min/MaxHeightOverGround are only wide safety bounds.",
      "Type": "Fly",
      "Acceleration": 10,
      "Deceleration": 8,
      "AutoLevel": true,
      "DesiredAltitudeWeight": 0,
      "MaxClimbAngle": 90,
      "MaxClimbSpeed": 30,
      "MaxHeightOverGround": 20,
      "MaxHorizontalSpeed": 15,
      "MaxRollAngle": 1,
      "MaxSinkAngle": 90,
      "MaxSinkSpeed": 3,
      "MaxTurnSpeed": 300,
      "MinAirSpeed": 0,
      "MinHeightOverGround": 1
    }
  ],
  "Instructions": [
    {
      "Instructions": [
        {
          "$Comment": "Start the lifespan timer once.",
          "Continue": true,
          "Sensor": {
            "Type": "Any",
            "Once": true
          },
          "Actions": [
            {
              "Type": "TimerStart",
              "Name": "DespawnTimer",
              "StartValueRange": {
                "Compute": "makeRange(DespawnTimer)"
              },
              "RestartValueRange": {
                "Compute": "makeRange(DespawnTimer)"
              }
            }
          ]
        },
        {
          "$Comment": "Lifespan over: vanish.",
          "Continue": true,
          "Sensor": {
            "Type": "Timer",
            "Name": "DespawnTimer",
            "State": "Stopped"
          },
          "Actions": [
            {
              "Type": "Despawn"
            }
          ]
        },
        {
          "Sensor": {
            "Type": "State",
            "State": "Idle"
          },
          "Instructions": [
            {
              "Sensor": {
                "Type": "State",
                "State": ".Default"
              },
              "Instructions": [
                {
                  "$Comment": "Not in a flock yet: join the nearest player's flock so that player becomes the leader.",
                  "Continue": true,
                  "Sensor": {
                    "Type": "Self",
                    "Filters": [
                      {
                        "Type": "Flock",
                        "FlockStatus": "NotMember"
                      }
                    ]
                  },
                  "Instructions": [
                    {
                      "Sensor": {
                        "Type": "Player",
                        "Range": 20
                      },
                      "Actions": [
                        {
                          "Type": "JoinFlock",
                          "ForceJoin": true
                        }
                      ]
                    }
                  ]
                },
                {
                  "$Comment": "Underground: out of sight (a wall or tunnel bend between us) or too far -> jump next to the leader. A straight-line Seek cannot follow a flame around a corner, so do not wait for it.",
                  "Sensor": {
                    "Type": "And",
                    "Sensors": [
                      {
                        "Type": "FlockLeader"
                      },
                      {
                        "Type": "Light",
                        "SkyLightRange": [
                          0,
                          95
                        ]
                      },
                      {
                        "Type": "Not",
                        "Sensor": {
                          "Type": "Player",
                          "Range": {
                            "Compute": "IndoorTeleportDistance"
                          },
                          "Filters": [
                            {
                              "Type": "LineOfSight"
                            }
                          ]
                        }
                      }
                    ]
                  },
                  "BodyMotion": {
                    "Type": "Teleport",
                    "OffsetRange": [
                      2,
                      3
                    ],
                    "MaxYOffset": 2
                  }
                },
                {
                  "$Comment": "Left behind (stuck in a low passage, or the player ran off): jump next to the leader. Same idea as the vanilla Test_Pet_Lantern.",
                  "Sensor": {
                    "Type": "And",
                    "Sensors": [
                      {
                        "Type": "FlockLeader"
                      },
                      {
                        "Type": "Not",
                        "Sensor": {
                          "Type": "Player",
                          "Range": {
                            "Compute": "CatchUpTeleportDistance"
                          }
                        }
                      }
                    ]
                  },
                  "BodyMotion": {
                    "Type": "Teleport",
                    "OffsetRange": [
                      2,
                      3
                    ],
                    "MaxYOffset": 2
                  }
                },
                {
                  "$Comment": "Low sky light (underground, caves, indoors; same test as vanilla Component_Sensor_Is_Indoors): follow a point low above the owner so a 2-block tunnel is fine.",
                  "Sensor": {
                    "Type": "And",
                    "Sensors": [
                      {
                        "Type": "AdjustPosition",
                        "Offset": {
                          "Compute": "IndoorFollowOffset"
                        },
                        "Sensor": {
                          "Type": "FlockLeader"
                        }
                      },
                      {
                        "Type": "Light",
                        "SkyLightRange": [
                          0,
                          95
                        ]
                      },
                      {
                        "Type": "Self",
                        "Filters": [
                          {
                            "Type": "Flock",
                            "FlockStatus": "Follower"
                          }
                        ]
                      }
                    ]
                  },
                  "HeadMotion": {
                    "Type": "Watch"
                  },
                  "BodyMotion": {
                    "Type": "Seek",
                    "SlowDownDistance": {
                      "Compute": "FollowSlowDownDistance"
                    },
                    "StopDistance": {
                      "Compute": "FollowStopDistance"
                    },
                    "RelativeSpeed": 1
                  }
                },
                {
                  "$Comment": "Open sky: follow a point well above the owner's head. The point moves with the owner, so ledges and slopes do not leave the flame behind.",
                  "Sensor": {
                    "Type": "And",
                    "Sensors": [
                      {
                        "Type": "AdjustPosition",
                        "Offset": {
                          "Compute": "OutdoorFollowOffset"
                        },
                        "Sensor": {
                          "Type": "FlockLeader"
                        }
                      },
                      {
                        "Type": "Light",
                        "SkyLightRange": [
                          96,
                          100
                        ]
                      },
                      {
                        "Type": "Self",
                        "Filters": [
                          {
                            "Type": "Flock",
                            "FlockStatus": "Follower"
                          }
                        ]
                      }
                    ]
                  },
                  "HeadMotion": {
                    "Type": "Watch"
                  },
                  "BodyMotion": {
                    "Type": "Seek",
                    "SlowDownDistance": {
                      "Compute": "FollowSlowDownDistance"
                    },
                    "StopDistance": {
                      "Compute": "FollowStopDistance"
                    },
                    "RelativeSpeed": 1
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "InteractionInstruction": {
    "$Comment": "Interacting with the flame dismisses it.",
    "Instructions": [
      {
        "Continue": true,
        "Sensor": {
          "Type": "Any"
        },
        "Actions": [
          {
            "Type": "SetInteractable",
            "Interactable": true
          }
        ]
      },
      {
        "Sensor": {
          "Type": "HasInteracted"
        },
        "Actions": [
          {
            "Type": "Despawn"
          }
        ]
      }
    ]
  }
}
